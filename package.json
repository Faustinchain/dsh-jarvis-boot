  ],
  "license": "MIT",
  "author": "Faustinchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faustinchain/dsh-jarvis-boot.git"
  },
  "homepage": "https://github.com/Faustinchain/dsh-jarvis-boot#readme",
